# Copy this file to .env.local and fill in the values from your Supabase project.
# Only the VITE_-prefixed variables are exposed to the front-end.

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Supabase publishable / anon key — safe for the browser (Project Settings -> API)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase SECRET key — SERVER ONLY. Never expose to the front-end / never prefix with VITE_.
SUPABASE_SECRET_KEY=

# Base URL of the JDIL Extract Worker (the Autoscale service that runs the
# well-plan extractor server-side). The "Extract" button POSTs to <this>/extract.
# e.g. https://jdil-extract-worker.<user>.replit.app  — leave blank locally to
# hide the button's network call (it will report the service is unconfigured).
VITE_EXTRACT_WORKER_URL=

# --- Extract Worker only (set these in the WORKER's Replit Secrets, not the SPA) ---
# ANTHROPIC_API_KEY  — used by the extractor (also used by the DMR/DDR scheduler).
# The worker also needs VITE_SUPABASE_URL + SUPABASE_SECRET_KEY (above).
# Optional: ALLOWED_ORIGINS (comma-separated) to override the default ORBIT origins.
