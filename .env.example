# Copy this file to .env.local and fill in the values from your Supabase project.
# Only the VITE_-prefixed variables are exposed to the front-end.

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Supabase publishable / anon key — safe for the browser (Project Settings -> API)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase SECRET key — SERVER ONLY. Never expose to the front-end / never prefix with VITE_.
SUPABASE_SECRET_KEY=
